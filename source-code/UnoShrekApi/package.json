    "nodemon",
    "google-auth-library",
    "rest-api",
    "e2e-testing",
    "unit-testing",
    "code-coverage",
    "logging",
    "environment-variables",
    "module-alias",
    "api-testing",
    "api-design",
    "api-architecture",
    "api-security",
    "api-documentation",
    "api-monitoring",
    "api-versioning",
    "api-testing-best-practices"
  ],
  "authors": [
    "Kauã Henrique Gonçalves",

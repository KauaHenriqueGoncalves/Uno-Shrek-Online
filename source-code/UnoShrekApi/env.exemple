API_PORT=(3000~3099, default:3000)
MONGODB_USER=any
MONGODB_PASSWORD=any
MONGODB_HOST=aby //caso esteja rodando o docker ao inves do local host, informe o container
MONGODB_PORT=(27000~27099, default:27017)
MONGODB_NAME=any
JWT_SECRET=any
PROFILE=(dev | prod, default:dev) //perfil que roda dev, o prefixo do socket é vazio, enquanto deve é preenchido pela variavel 
SOCKET_PATH=any (default: /socket) //just work when profile is "prod", another the path is empty
GOOGLE_CLIENT_ID=any
GOOGLE_CLIENT_SECRET=any
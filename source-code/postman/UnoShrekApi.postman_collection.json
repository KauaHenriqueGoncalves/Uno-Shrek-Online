{
  "info": {
    "name": "UnoShrek API",
    "description": "Coleção de requisições de exemplo para a API do UnoShrek (jogo UNO digital). Cobre os endpoints de Health, Players e Games.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b3f2a6b0-2e1a-4b1a-9f1e-unoshrekapi001"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "playerId",
      "value": "",
      "type": "string",
      "description": "Preenchido automaticamente após o POST em /api/players"
    },
    {
      "key": "gameId",
      "value": "",
      "type": "string",
      "description": "Preenchido automaticamente após o POST em /api/games"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "Listar jogadores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/players",
              "host": ["{{baseUrl}}"],
              "path": ["api", "players"]
            }
          },
          "response": []
        },
        {
          "name": "Buscar jogador por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/players/{{playerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "players", "{{playerId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Criar jogador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"playerId\", body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"age\": 25,\n  \"email\": \"joao.silva@email.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/players",
              "host": ["{{baseUrl}}"],
              "path": ["api", "players"]
            }
          },
          "response": []
        },
        {
          "name": "Atualizar jogador",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva Neto\",\n  \"age\": 26\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/players/{{playerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "players", "{{playerId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Excluir jogador",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/players/{{playerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "players", "{{playerId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Games",
      "item": [
        {
          "name": "Listar jogos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/games",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games"]
            }
          },
          "response": []
        },
        {
          "name": "Buscar jogo por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/games/{{gameId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{gameId}}"]

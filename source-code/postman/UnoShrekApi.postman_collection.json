          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Partida da Sexta - Revanche\",\n  \"maxPlayers\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/games/{{gameId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games", "{{gameId}}"]
            }
          },
          "response": []

            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Partida da Sexta\",\n  \"maxPlayers\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/games",
              "host": ["{{baseUrl}}"],
              "path": ["api", "games"]
            }
          },
          "response": []
